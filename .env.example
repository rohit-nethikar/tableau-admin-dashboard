# Copy to .env only for local development.
# Do NOT commit the real .env file.
#
# The application does not automatically load .env; your hosting platform should
# inject these values as environment variables.

APP_HOST=0.0.0.0
APP_PORT=5000

# Persistent writable directory. In a container/VM, mount persistent storage here.
APP_DATA_DIR=/app/data

# Set this in the hosting platform's secret store.
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Optional overrides. If omitted, config.yaml continues to provide these values.
TABLEAU_SERVER_URL=
TABLEAU_SITES=
TABLEAU_DEFAULT_SITE=
REFRESH_INTERVAL_MINUTES=
SITE_SWITCH_STALENESS_MINUTES=
STALE_THRESHOLD_DAYS=

# BigQuery authentication.
# Prefer workload/application default credentials in the hosting platform.
# If your approved environment requires a service-account file, mount it securely
# outside the source tree and point this variable at that mounted file.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional SMTP overrides
SMTP_HOST=
SMTP_PORT=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
